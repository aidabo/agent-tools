# Stop-notify webhook env values for clawhip native hook
# Example:
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# DISCORD_WEBHOOK_URL_AGENT1=https://discord.com/api/webhooks/...
# DISCORD_WEBHOOK_URL_AGENT2=https://discord.com/api/webhooks/...
# CLAWHIP_NOTIFY_PROJECT_ROOT=/path/to/workspace/repo
# CLAWHIP_NOTIFY_STATE_ROOT=/path/to/workspace/repo/.omx/notify-state
# CLAWHIP_STOP_CAPTURE_DELAY_MS=400
# CLAWHIP_NOTIFY_CHUNK_SIZE=3200
# CLAWHIP_NOTIFY_CHUNK_DELAY_MS=100
# CLAWHIP_DISCORD_MESSAGE_MODE=content
# CLAWHIP_DISCORD_EMBED_COLOR=0x5865F2
